# ============================================================================
# Слепок dev-сервера: версионируем только рабочую тему кабинета
#
# ftp/ — зеркало mydev.hostfly.by (~655 МБ), синкается по FTP. Из него в git
# входит только templates/ais. Подробно: CLAUDE.md
# ============================================================================
/ftp/*
!/ftp/public/
/ftp/public/*
!/ftp/public/templates/
/ftp/public/templates/*
!/ftp/public/templates/ais/

# Внутри темы
/ftp/public/templates/ais/_dev/temp/
/ftp/public/templates/ais/**/node_modules/

